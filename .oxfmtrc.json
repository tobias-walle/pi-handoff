{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "sortSideEffects": false,
    "partitionByComment": true,
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": ["package-lock.json", ".check-cache/**", "coverage/**"]
}
