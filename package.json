{
  "name": "pi-handoff",
  "version": "0.1.0",
  "description": "Let your pi agent continue a task in a fresh session.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobias-walle/pi-handoff"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "scripts": {
    "check": "node scripts/check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --config oxlint.config.ts --deny-warnings src tests scripts *.ts",
    "fix": "oxlint --config oxlint.config.ts --fix src tests scripts *.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.ts",
    "dev": "pi --no-extensions -e ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "1.4.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
